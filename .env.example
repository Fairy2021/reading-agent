# Project
APP_ENV=development
APP_NAME=StoryVerse Agent
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true

# API / LLM
OPENAI_API_KEY=
OPENAI_BASE_URL=https://open.xiaojingai.com/v1
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
LLM_TIMEOUT_SECONDS=30
UPLOAD_DIR=/app/data/uploads

# Embedding (local | remote)
# local: use deterministic local embedding (offline/dev)
# remote: call OpenAI-compatible /embeddings endpoint
EMBEDDING_PROVIDER=remote
EMBEDDING_API_BASE_URL=https://open.xiaojingai.com/v1
EMBEDDING_API_KEY=
# Chinese-friendly recommendation (if provider supports): BAAI/bge-m3
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSIONS=1536
EMBEDDING_TIMEOUT_SECONDS=30

# Skills
SKILL_CHARACTER_MIN_MENTIONS=3
SKILL_CHARACTER_MAX_COUNT=80
SKILL_EVIDENCE_PER_CHARACTER=5
SKILL_CHARACTER_LLM_SEGMENT_LEN=4500
SKILL_CHARACTER_LLM_MAX_SEGMENTS=1
SKILL_CHARACTER_FALLBACK_ENABLED=true
SKILL_CHARACTER_ALIAS_MERGE_ENABLED=true
SKILL_DEFAULT_INCREMENTAL=true
SKILL_STATE_RECENT_EVIDENCE=3
SKILL_CARD_LLM_ENABLED=true
SKILL_CARD_LLM_MAX_CHARACTERS_PER_RUN=40
SKILL_CARD_EVIDENCE_CHARS=1400
SKILL_RELATIONSHIP_LLM_SEGMENT_LEN=3200
SKILL_RELATIONSHIP_LLM_MAX_SEGMENTS=1
SKILL_RELATIONSHIP_FALLBACK_ENABLED=true
SKILL_REFINE_LLM_ENABLED=true
SKILL_REFINE_LLM_MAX_CANDIDATES=40
SKILL_REFINE_MERGE_RATIO=1.0
SKILL_DENOISE_LLM_ENABLED=true
SKILL_DENOISE_LLM_MAX_CANDIDATES=120
CHAT_SESSION_MEMORY_MAX_CHARS=900
CHAT_GUARD_ENABLED=true

# Portrait generation
PORTRAIT_GENERATION_ENABLED=true
PORTRAIT_API_URL=
PORTRAIT_API_TOKEN=
PORTRAIT_API_TIMEOUT_SECONDS=45
PORTRAIT_API_SEED_FIELD=seed
PORTRAIT_API_PROMPT_FIELD=prompt
PORTRAIT_MODEL=gemini-3-pro-image-preview
PORTRAIT_API_RESPONSE_URL_FIELD=image_url
PORTRAIT_GENERATOR_NAME=external_image_api
PORTRAIT_CACHE_ENABLED=true
PORTRAIT_CACHE_DIR=/app/data/uploads/portraits

# Database
POSTGRES_USER=storyverse
POSTGRES_PASSWORD=storyverse
POSTGRES_DB=storyverse
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://storyverse:storyverse@postgres:5432/storyverse

# Redis / Celery
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
